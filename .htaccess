# ==============================================================================
# Aim Infocorp - Modular URL Routing
# ==============================================================================

DirectoryIndex index.php
RewriteEngine On

# Base structure for XAMPP subdirectory
#----for local server
RewriteBase /Aim-Rebuild/Aim-site/

#----for live server
# RewriteBase /

# 1. Project Detail Routing
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^project/([^/]+)/?$ project-detail.php?slug=$1 [L,QSA]

# 2. Local Service Routing (State/City)
# URL: /services/slug/state/city
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^services/([^/]+)/([^/]+)/([^/]+)/?$ service-pages/service-detail.php?slug=$1&state=$2&city=$3 [L,QSA]

# URL: /services/slug/state
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^services/([^/]+)/([^/]+)/?$ service-pages/service-detail.php?slug=$1&state=$2 [L,QSA]

# 3. Main Service Detail Routing
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^services/([^/]+)/?$ service-pages/service-detail.php?slug=$1 [L,QSA]

# 4. Technology Detail Routing
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^technology/([^/]+)/?$ technology-detail.php?slug=$1 [L,QSA]

# 5. External Redirects for Clean URLs
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{QUERY_STRING} ^slug=([^&]+)$
RewriteRule ^project-detail(\.php)?$ project/%1? [R=301,L]

RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{QUERY_STRING} ^slug=([^&]+)$
RewriteRule ^service-pages/service-detail(\.php)?$ services/%1? [R=301,L]

RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{QUERY_STRING} ^slug=([^&]+)$
RewriteRule ^technology-detail(\.php)?$ technology/%1? [R=301,L]

# 6. Remove index.php from root
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^index(\.php)?$ ./ [R=301,L]

# 7. Force Extensionless PHP Files
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} -f
RewriteCond %{REQUEST_URI} ^(.+)\.php$
RewriteCond %{REQUEST_URI} !handlers/
RewriteRule ^ %1 [R=301,L]

# Internal rewrite to .php
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L,QSA]

# 8. Remove trailing slashes
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} (.+)/$
RewriteRule ^(.*)/$ $1 [L,R=301]

# ==============================================================================
# Performance & Error Handling
# ==============================================================================

# Custom 404 Page
# NOTE: For local server
# ErrorDocument 404 /Aim-Rebuild/Aim-site/404.php

# NOTE: For live server
ErrorDocument 404 /404.php

# Browser Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/x-javascript "access plus 1 month"
    ExpiresDefault "access plus 2 days"
</IfModule>