# ==============================================================================
# Aim Infocorp - Modular URL Routing
# ==============================================================================

DirectoryIndex index.php
RewriteEngine On

# Canonical domain redirect (non-www to www-less)
RewriteCond %{HTTP_HOST} ^www\.aiminfocorp\.com$ [NC]
RewriteRule ^(.*)$ https://aiminfocorp.com/$1 [R=301,L]

# ==============================================================================
# Dynamic Base Path Detection (Zero-Config for Local vs Live)
# ==============================================================================
RewriteCond %{HTTP_HOST} ^(localhost|127\.0\.0\.1)$
RewriteRule ^ - [E=BASE:/Aim-Rebuild/Aim-site/]

RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)$
RewriteRule ^ - [E=BASE:/]

# redirection
RewriteRule ^about/?$ %{ENV:BASE}about-us [R=301,L]
RewriteRule ^service/?$ %{ENV:BASE}services [R=301,L]

# 1. Project Detail Routing
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^project/([^/]+)/?$ project-detail.php?slug=$1 [L,QSA]

# 2. Local Service Routing (State/City)
# URL: /services/slug/state/city
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^services/([^/]+)/([^/]+)/([^/]+)/?$ service-pages/service-detail.php?slug=$1&state=$2&city=$3 [L,QSA]

# URL: /services/slug/state
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^services/([^/]+)/([^/]+)/?$ service-pages/service-detail.php?slug=$1&state=$2 [L,QSA]

# 3. Main Service Detail Routing
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^services/([^/]+)/?$ service-pages/service-detail.php?slug=$1 [L,QSA]

# 4. Technology Detail Routing
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^technology/([^/]+)/?$ technology-detail.php?slug=$1 [L,QSA]

# 5. External Redirects for Clean URLs
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{QUERY_STRING} ^slug=([^&]+)$
RewriteRule ^project-detail(\.php)?$ %{ENV:BASE}project/%1? [R=301,L]

RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{QUERY_STRING} ^slug=([^&]+)$
RewriteRule ^service-pages/service-detail(\.php)?$ %{ENV:BASE}services/%1? [R=301,L]

RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{QUERY_STRING} ^slug=([^&]+)$
RewriteRule ^technology-detail(\.php)?$ %{ENV:BASE}technology/%1? [R=301,L]

# 6. Remove index.php from root
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^index(\.php)?$ %{ENV:BASE} [R=301,L]

# 7. Force Extensionless PHP Files
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} -f
RewriteCond %{REQUEST_URI} ^(.*)/([^/]+)\.php$
RewriteCond %{REQUEST_URI} !handlers/
RewriteRule ^ %1/%2 [R=301,L]

# 8. Remove trailing slashes (MUST be before internal rewrites to prevent invalid path generation)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} ^(.*)/+$
RewriteRule ^ %1 [L,R=301]

# Internal rewrite to .php
# We check that the URI doesn't already end in .php to prevent Apache from continuously appending it
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteCond %{REQUEST_URI} !\.php$ [NC]
RewriteRule ^(.*)$ $1.php [L,QSA]

# ==============================================================================
# Performance & Error Handling
# ==============================================================================

# Disable MultiViews to prevent Apache from guessing file extensions
Options -MultiViews

# Universal 404 Routing (Works perfectly on local and live)
RewriteCond %{REQUEST_URI} !404\.php$ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ %{ENV:BASE}404.php [L]

# Browser Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/x-javascript "access plus 1 month"
    ExpiresDefault "access plus 2 days"
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>